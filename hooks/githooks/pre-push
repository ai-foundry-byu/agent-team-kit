#!/usr/bin/env bash
# Pre-push gate — run the fast hermetic checks before a push. A push often
# triggers a paid build / deploy, so the bar to cross it is "the fast checks are
# green": typecheck + the unit/arch test suite. Catching a red build locally
# saves a wasted paid build, not just time.
#
# Tag must-never-break E2E specs `@critical` and run them here (see TEST_CMD).
# Keep this gate FAST (no full E2E, no full build) so it doesn't discourage
# pushing; run the heavy suite in CI post-push.
#
# Emergency bypass: git push --no-verify
#
# ── CONFIG: set your project's commands ─────────────────────────────────────
CHECK_CMD="pnpm -s check"          # typecheck (tsc --noEmit / svelte-check / etc.)
TEST_CMD="pnpm -s test"            # unit + arch tests. Add your @critical E2E, e.g.:
                                   #   TEST_CMD="pnpm -s test && pnpm exec playwright test --grep @critical"
# ────────────────────────────────────────────────────────────────────────────

set -uo pipefail

root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 0

# Nothing to push? pre-push gets refs on stdin; a delete/prune push sends the
# all-zero sha. Skip in those cases so the gate never blocks a no-op push.
if [ -t 0 ]; then : ; else
  read -r _local_ref _local_sha _remote_ref _remote_sha || true
  case "${_local_sha:-}" in
    "" | 0000000000000000000000000000000000000000) exit 0 ;;
  esac
fi

echo "→ pre-push: $CHECK_CMD && $TEST_CMD (fast gate before a push)…"

if ! $CHECK_CMD; then
  echo ""
  echo "✗ check failed — push blocked. Fix the errors above."
  echo "  Bypass (you own what ships): git push --no-verify"
  exit 1
fi

if ! $TEST_CMD; then
  echo ""
  echo "✗ tests failed — push blocked. A unit / regression / critical test is red."
  echo "  Bypass (you own what ships): git push --no-verify"
  exit 1
fi

echo "✓ pre-push checks passed."
exit 0
